{
	"schemaVersion": 1,
	"id": "fuzzy-command-history",
	"version": "${version}",
	"name": "Fuzzy Command History",
	"description": "Adds interactive fuzzy search for chat command history, inspired by fzf.",
	"authors": ["medicalwhiskey"],
	"contact": {
		"homepage": "https://modrinth.com/mod/fuzzy-command-history",
		"sources": "https://github.com/victorfaurschou/fuzzy-command-history",
		"issues": "https://github.com/victorfaurschou/fuzzy-command-history/issues"
	},
	"license": "MIT",
	"icon": "assets/fuzzy-command-history/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.victorfaurschou.fuzzycommandhistory.client.FuzzyCommandHistoryClient"],
		"modmenu": ["com.victorfaurschou.fuzzycommandhistory.client.ModMenuIntegration"]
	},
	"mixins": [
		{"config": "fuzzy-command-history.client.mixins.json", "environment": "client"}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": ">=0.119.2",
		"cloth-config": ">=26.1.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
